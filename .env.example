# =============================================
# ZimMarket - Production Environment Variables
# =============================================
# Copy this to .env and fill in real values

# Database - Use PostgreSQL for production
DATABASE_PROVIDER="postgresql"
DATABASE_URL="postgresql://user:password@host:5432/zimmarket?schema=public"

# Authentication - Generate a secure random string (min 32 chars)
JWT_SECRET=""

# Application
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"
NEXT_PUBLIC_APP_NAME="ZimMarket"

# =============================================
# Optional Integrations (configure when ready)
# =============================================

# Payment Providers
# STRIPE_SECRET_KEY=""
# STRIPE_PUBLISHABLE_KEY=""
# ECOCASH_API_KEY=""

# Email Service
# SMTP_HOST=""
# SMTP_PORT=""
# SMTP_USER=""
# SMTP_PASS=""
# FROM_EMAIL="noreply@zimmarket.co.zw"

# SMS/OTP
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_PHONE_NUMBER=""

# AI Enhancement
# OPENAI_API_KEY=""

# File Storage (for production image uploads)
# AWS_S3_BUCKET=""
# AWS_S3_REGION=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
