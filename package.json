{
  "name": "zimmarket",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node_modules/.bin/prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "node_modules/.bin/prisma generate",
    "db:push": "node_modules/.bin/prisma db push",
    "db:seed": "ts-node --compiler-options {\"module\":\"commonjs\",\"esModuleInterop\":true} prisma/seed.ts",
    "db:studio": "node_modules/.bin/prisma studio"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "^3.0.3",
    "cookie": "^1.1.1",
    "jsonwebtoken": "^9.0.3",
    "next": "14.2.35",
    "prisma": "5.22.0",
    "react": "^18",
    "react-dom": "^18",
    "slugify": "^1.6.9",
    "uuid": "^14.0.2",
    "vercel": "^63.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/uuid": "^10.0.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
